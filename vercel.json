{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/portfolio",
      "destination": "/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/contact",
      "destination": "https://oktavio-studio.oktavio.workers.dev/api/contact"
    },
    {
      "source": "/content.js",
      "destination": "https://oktavio-studio.oktavio.workers.dev/content.js"
    },
    {
      "source": "/portfolio-content.js",
      "destination": "https://oktavio-studio.oktavio.workers.dev/portfolio-content.js"
    },
    {
      "source": "/prompts.mjs",
      "destination": "https://oktavio-studio.oktavio.workers.dev/prompts.mjs"
    }
  ]
}
