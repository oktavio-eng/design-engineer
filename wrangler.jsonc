    "database_name": "oktavio-studio",
    "database_id": "9c0f040a-6b64-4a1d-9e26-263b0cb2dada",
    "migrations_dir": "cloudflare/migrations"
  }],
  "vars": {
    "LOCAL_DEV": "false",
    "SITE_ORIGIN": "https://oktavio.vercel.app",
    "ACCESS_TEAM_DOMAIN": "https://oktavio.cloudflareaccess.com",
    "ACCESS_AUD": "770041307546001a17307fa6eb407784b9ec1b076b89572853f8ae7e973ae3a6",
    "ADMIN_EMAIL": "oktavio@gowstudio.pro"
  }
}
